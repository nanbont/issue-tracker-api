# Copy this file to .env and adjust the values. NEVER commit the real .env file.
NODE_ENV=development
PORT=3000

# Local MongoDB (default) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/issue_tracker
# Separate database used only by the automated tests (it is dropped between tests!)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/issue_tracker_test

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12 